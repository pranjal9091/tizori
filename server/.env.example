PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==============================================================================
# 1. DATABASE CONFIGURATION (MongoDB Atlas / Self-hosted / Local)
# ==============================================================================
# Paste your real MongoDB Atlas connection string here:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pocketpaisa?retryWrites=true&w=majority
# (If left empty, PocketPaisa automatically runs high-speed in-memory MongoDB for local dev)
MONGODB_URI=

# ==============================================================================
# 2. AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized JavaScript origin must be: http://localhost:3000
GOOGLE_CLIENT_ID=

# ==============================================================================
# 3. GMAIL SECURITY NOTIFICATION SERVICE (Nodemailer SMTP)
# ==============================================================================
# 1. SMTP_USER: Your Gmail address (e.g., yourname@gmail.com)
# 2. SMTP_PASS: 16-character Google App Password (generate at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PocketPaisa Security <noreply@pocketpaisa.app>

# ==============================================================================
# 4. PAYMENT GATEWAY CONFIGURATION (Razorpay - India UPI / Cards / NetBanking)
# ==============================================================================
# Get your free test/live keys in 2 minutes from https://dashboard.razorpay.com (Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ==============================================================================
# 5. GLOBAL PAYMENT GATEWAY (Stripe - Cards)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
